generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  secondmeUserId  String   @unique
  name            String
  email           String?
  avatarUrl       String?
  route           String?
  accessToken     String?
  refreshToken    String?
  tokenExpiresAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agents Agent[]
}

model Agent {
  id              String   @id @default(cuid())
  userId          String
  name            String
  avatarEmoji     String   @default("")
  personalityType String   @default("")
  interests       String   @default("[]") // Keep JSON text for current API compatibility
  catchphrase     String   @default("")
  secondmeRoute   String   @default("")
  status          String   @default("online")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model A2AAgent {
  id              String   @id @default(cuid())
  url             String   @unique  // The base URL of the A2A agent
  name            String
  avatarEmoji     String   @default("\uD83E\uDD9E")
  personalityType String   @default("")
  interests       String   @default("[]")
  catchphrase     String   @default("")
  status          String   @default("online")
  agentCardRaw    String   @default("{}")  // Raw JSON of the fetched agent card
  createdAt       DateTime @default(now())
  registeredBy    String?  // userId of the person who registered this agent
}

model Event {
  id             String   @id @default(cuid())
  name           String
  phase          String   @default("registration")
  currentRound   Int      @default(0)
  totalRounds    Int      @default(0)
  turnsPerAgent  Int      @default(5) // Messages per agent per date (2-10)
  participantIds String   @default("[]") // JSON snapshot of participating agent ids
  createdAt      DateTime @default(now())

  pairings Pairing[]
}

model Pairing {
  id                 String  @id @default(cuid())
  eventId            String
  agentAId           String
  agentBId           String
  compatibilityScore Float?
  reasoning          String?
  round              Int     @default(0)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dateSessions DateSession[]

  @@index([eventId])
  @@index([round])
}

model DateSession {
  id            String   @id @default(cuid())
  pairingId     String
  status        String   @default("pending")
  round         Int      @default(0)
  chatSessionId String?
  createdAt     DateTime @default(now())

  pairing  Pairing   @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  messages Message[]
  ratings  Rating[]

  @@index([pairingId])
  @@index([status])
}

model Message {
  id            String   @id @default(cuid())
  dateSessionId String
  senderId      String
  senderName    String
  content       String
  turn          Int      @default(0)
  createdAt     DateTime @default(now())

  dateSession DateSession @relation(fields: [dateSessionId], references: [id], onDelete: Cascade)

  @@index([dateSessionId])
}

model Rating {
  id            String  @id @default(cuid())
  dateSessionId String
  agentId       String
  agentName     String
  score         Float
  comment       String?

  dateSession DateSession @relation(fields: [dateSessionId], references: [id], onDelete: Cascade)

  @@index([dateSessionId])
}
